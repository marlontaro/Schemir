{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataDiff",
  "version": "0.1.0",
  "identifier": "pe.soen.datadiff",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DataDiff — Comparador de objetos",
        "width": 1180,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
